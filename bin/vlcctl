#!/bin/bash
#
# vlcctl — start or stop a headless VLC instance via its RC interface
#
# Requires: cvlc (vlc), netcat (nc) with -q and -z support
#   On Debian/Ubuntu:  sudo apt install netcat-traditional
#   On Alpine (Docker): apk add netcat-openbsd   <- does NOT support -q, use ncat instead
#   On Alpine (ncat):   apk add nmap-ncat         <- supports -q
#

checkDependencies () {
    local missing=0
    for cmd in nc cvlc; do
        if ! command -v "$cmd" > /dev/null 2>&1; then
            echo "Error: '$cmd' is required but not installed." >&2
            missing=1
        fi
    done
    if [ "$missing" -eq 1 ]; then
        exit 1
    fi
}

checkDependencies

CVLC_RC_HOST="localhost"
CVLC_RC_PORT="1234"
DO_QUIT=0
DO_BACKGROUND=0

# starts vlc as a background daemon
vlcStart () {
    cvlc --extraintf rc --rc-host "$CVLC_RC_HOST:$CVLC_RC_PORT"
}

vlcStartBackground () {
    vlcStart &
}

# sends input to the vlc rc interface and prints the response
vlcQuery () {
    netcat -q 1 "$CVLC_RC_HOST" "$CVLC_RC_PORT"
}

# sends a single RC command to VLC
vlcCommand () {
    echo "$1" | vlcQuery
}

# sends the quit command to a running VLC instance
vlcQuit () {
    vlcCommand quit
}

# returns 0 if VLC RC interface is reachable, 1 otherwise
vlcIsRunning () {
    nc -z "$CVLC_RC_HOST" "$CVLC_RC_PORT" 2>/dev/null
}

usage () {
    echo "Usage: $(basename "$0") [-h host] [-p port] [-b] [-q]"
    echo "  -h HOST  VLC RC host (default: $CVLC_RC_HOST)"
    echo "  -p PORT  VLC RC port (default: $CVLC_RC_PORT)"
    echo "  -b       Run VLC in the background"
    echo "  -q       Quit a running VLC instance instead of starting one"
    exit 1
}

while getopts ":h:p:bq" opt; do
    case $opt in
        h) CVLC_RC_HOST="$OPTARG" ;;
        p) CVLC_RC_PORT="$OPTARG" ;;
        b) DO_BACKGROUND=1 ;;
        q) DO_QUIT=1 ;;
        :) echo "Option -$OPTARG requires an argument." >&2; usage ;;
        \?) echo "Unknown option: -$OPTARG" >&2; usage ;;
    esac
done

if [ "$DO_QUIT" -eq 1 ]; then
    vlcQuit
elif vlcIsRunning; then
    echo "VLC is currently running at port $CVLC_RC_PORT"
elif [ "$DO_BACKGROUND" -eq 1 ]; then
    vlcStartBackground
else
    trap 'vlcQuit' INT
    vlcStart
fi
