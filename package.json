{
  "name": "radio-soundtracker",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "poc": "node --import tsx poc/run.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/locales', 'dist/locales', { recursive: true })\"",
    "start": "node dist/index.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src __tests__ poc",
    "vlcctl:start": "./bin/vlcctl",
    "vlcctl:stop": "./bin/vlcctl -q && echo \"VLC was running\" || echo \"VLC was not running\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "i18next": "^26.0.3",
    "i18next-fs-backend": "^2.6.3",
    "node-cron": "^4.1.1",
    "tsx": "^4.21.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laboralphy/radio-soundtracker.git"
  },
  "bugs": {
    "url": "https://github.com/Laboralphy/radio-soundtracker/issues"
  },
  "homepage": "https://github.com/Laboralphy/radio-soundtracker#readme"
}
