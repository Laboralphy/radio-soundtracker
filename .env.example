# Copy to .env and adjust. Command line options override these values.
RADIO_VLC_HOST=localhost
RADIO_VLC_PORT=1234
RADIO_VLC_TIMEOUT=1000
RADIO_LOG_DIR=logs

# Broadcast (the "broadcast" command)
# PulseAudio/PipeWire null sink that VLC plays into and ffmpeg records
RADIO_SINK=radio
RADIO_VIDEO_SIZE=854x480
RADIO_FPS=30
RADIO_VIDEO_BITRATE=1500k
RADIO_AUDIO_BITRATE=160k
# A file for local tests (.flv), or rtmps://a.rtmp.youtube.com/live2/<stream key>
# The stream key is a secret: keep it in .env only, it is never logged.
RADIO_OUTPUT=broadcast.flv
